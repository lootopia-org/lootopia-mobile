EXPO_PUBLIC_API_URL=https://api.wookiesrpeople2.dev
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Must match NEXT_PUBLIC_MOBILE_CAPTURE_LINK in lootopia-frontend/.env.local
# ({sessionId} is replaced with the capture session id)
#
# Production / dev build:
#   EXPO_PUBLIC_MOBILE_CAPTURE_LINK=lootopia://capture/{sessionId}
#
# Expo Go + tunnel — copy the "exp://…" host from `npx expo start --tunnel`:
#   EXPO_PUBLIC_MOBILE_CAPTURE_LINK=exp://YOUR-TUNNEL.exp.direct/--/capture/{sessionId}

EXPO_PUBLIC_MOBILE_CAPTURE_LINK=lootopia://capture/{sessionId}
