{
  "expo": {
    "name": "Lootopia Mobile",
    "slug": "lootopia-mobile",
    "scheme": "lootopia",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Lootopia uses your camera to capture hunt step photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lootopia uses your location to track hunt progress and validate checkpoints."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fff4ec"
      }
    }
  }
}
